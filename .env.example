# Copy to .env and fill in. The bot reads .env at the project root on startup.
# Values already present in the real environment take precedence over this file.

# Required to run the bot.
DISCORD_TOKEN=

# Needed only for the one-time `npm run register` (slash commands).
APP_ID=
GUILD_ID=

# Card data. Defaults to the bundled clone, so you can leave this unset.
# ARKHAM_DATA=./arkhamdb-json-data-master

# Optional.
# DB_PATH=./arkham.sqlite
# HOST_ROLE_ID=
# ARCHIVE_CATEGORY_ID=
# NARRATOR_WEBHOOK=0

# Card faces: linked from ArkhamDB, never bundled. CARD_IMAGES=off hides them.
# CARD_IMAGES=on
# CARD_IMAGE_BASE=https://arkhamdb.com/bundles/cards/
# CARD_IMAGE_EXT=.png
