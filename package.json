{
  "name": "arkham-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic Arkham-style rules kernel with a Discord adapter. No AI.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "simulate": "node --disable-warning=ExperimentalWarning scripts/simulate.ts",
    "coverage": "node --disable-warning=ExperimentalWarning scripts/coverage.ts",
    "register": "node --disable-warning=ExperimentalWarning scripts/register.ts",
    "start": "node --disable-warning=ExperimentalWarning src/main.ts"
  },
  "dependencies": {
    "discord.js": "^14.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
